{
  "name": "fahtzee",
  "private": true,
  "description": "Build inputs for Fahtzee. index.html is generated from these; never hand edit it.",
  "scripts": {
    "build": "esbuild entry.jsx --bundle --minify --format=iife --outfile=bundle.js --loader:.jsx=jsx --jsx=automatic",
    "test": "node test/streaks.js && node test/skins.js",
    "test:streaks": "node test/streaks.js",
    "test:skins": "node test/skins.js"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "playwright": "^1.40.0"
  }
}
